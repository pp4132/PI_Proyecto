{
  "version": 2,
  "builds": [
    {
      "src": "src/*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/src/Index.php"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/src/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/src/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/src/js/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/src/img/$1"
    }
  ]
}
